  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="tutorial2.cpp" />
    <ClCompile Include="recovery.cpp" /><ClCompile Include="practice.cpp" />
    <ClInclude Include="recovery.h" /><ClInclude Include="practice.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="InstallTutorial" AfterTargets="Build">
    <MakeDir Directories="$(TorcsRuntimeDir)drivers\tutorial2" />
