      <ModuleDefinitionFile>tutorial2.def</ModuleDefinitionFile>
      <IgnoreSpecificDefaultLibraries Condition="'$(Configuration)'=='Debug'">LIBCMT;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
