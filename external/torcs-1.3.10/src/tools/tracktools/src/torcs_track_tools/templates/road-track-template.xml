<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE params SYSTEM "../../../src/libs/tgf/params.dtd" [
<!ENTITY default-surfaces SYSTEM "../../../data/tracks/surfaces.xml">
]>

<!--
  Generic road-track template for deterministic scripted mainline rebuilds.
  This file is a conservative skeleton intended for non-pit mainline assembly.
  Real generated tracks must pass a non-placeholder author to torcs-rebuild-mainline.
-->
<params name="Road Track Template" type="trackdef" mode="mw">
	<section name="Header">
		<attstr name="name" val="Road Track Template" />
		<attstr name="category" val="road" />
		<attstr name="subcategory" val="road" />
		<attnum name="version" val="4" />
		<attstr name="author" val="REQUIRED_BY_TORCS_TRACK_TOOLS" />
		<attstr name="description" val="Generic road-track template for scripted mainline rebuilds" />
	</section>
	<section name="Graphic">
		<attstr name="3d description" val="none.ac" />
		<attstr name="background image" val="" />
		<attnum name="background type" val="0" />
		<attnum name="background color R" val="0.72" />
		<attnum name="background color G" val="0.82" />
		<attnum name="background color B" val="0.95" />
		<attnum name="ambient color R" val="0.2" />
		<attnum name="ambient color G" val="0.2" />
		<attnum name="ambient color B" val="0.2" />
		<attnum name="diffuse color R" val="1.0" />
		<attnum name="diffuse color G" val="1.0" />
		<attnum name="diffuse color B" val="1.0" />
		<attnum name="specular color R" val="0.1" />
		<attnum name="specular color G" val="0.1" />
		<attnum name="specular color B" val="0.1" />
		<attnum name="light position x" val="-9000" />
		<attnum name="light position y" val="8000" />
		<attnum name="light position z" val="9000" />
		<section name="Terrain Generation">
			<attnum name="track step" unit="m" val="10" />
			<attnum name="border margin" unit="m" val="180" />
			<attnum name="border step" unit="m" val="35" />
			<attnum name="border height" unit="m" val="8" />
			<attstr name="orientation" val="clockwise" />
			<attnum name="group size" val="220" />
			<attstr name="surface" val="grass6" />
		</section>
	</section>
	<section name="Surfaces">
		&default-surfaces;
		<section name="manual-asphalt">
			<attstr name="texture name" val="tr-road1.rgb" />
			<attstr name="texture type" val="continuous" />
			<attnum name="texture size" unit="m" val="15.0001" />
			<attnum name="texture mipmap" unit="m" val="0.0" />
			<attstr name="texture start on boundary" val="yes" />
			<attstr name="texture link with previous" val="yes" />
			<attstr name="raceline name" val="raceline.png" />
			<attnum name="friction" val="1.06" />
			<attnum name="rolling resistance" val="0.021" />
			<attnum name="roughness" val="0.0007" />
			<attnum name="roughness wavelength" val="2.0" />
		</section>
		<section name="manual-barrier">
			<attstr name="texture name" val="arbor2_n.rgb" />
			<attstr name="texture type" val="continuous" />
			<attnum name="texture size" unit="m" val="10.0" />
			<attnum name="texture mipmap" val="0.0" />
			<attnum name="friction" val="0.0" />
			<attnum name="dammage" val="10" />
		</section>
	</section>
	<section name="Starting Grid">
		<attnum name="rows" val="2" />
		<attstr name="pole position side" val="left" />
		<attnum name="distance to start" unit="m" val="4.0" />
		<attnum name="distance between columns" unit="m" val="15.0" />
		<attnum name="offset within a column" unit="m" val="7.5" />
	</section>
	<section name="Main Track">
		<attnum name="width" unit="m" val="12.0" />
		<attstr name="surface" val="manual-asphalt" />
		<attnum name="profil steps length" unit="m" val="6.0" />
		<attnum name="raceline widthscale" val="1.5" />
		<attnum name="raceline int" val="3" />
		<attnum name="raceline ext" val="3" />
		<section name="Left Border">
			<attnum name="width" unit="m" val="1.0" />
			<attstr name="style" val="plan" />
			<attstr name="surface" val="b-road1-grass6" />
		</section>
		<section name="Right Border">
			<attnum name="width" unit="m" val="1.0" />
			<attstr name="style" val="plan" />
			<attstr name="surface" val="b-road1-grass6" />
		</section>
		<section name="Left Side">
			<attnum name="width" unit="m" val="7.0" />
			<attstr name="banking type" val="level" />
			<attstr name="surface" val="grass6" />
		</section>
		<section name="Right Side">
			<attnum name="width" unit="m" val="7.0" />
			<attstr name="banking type" val="level" />
			<attstr name="surface" val="grass6" />
		</section>
		<section name="Left Barrier">
			<attnum name="width" unit="m" val="0.0" />
			<attnum name="height" unit="m" val="4.0" />
			<attstr name="style" val="fence" />
			<attstr name="surface" val="manual-barrier" />
		</section>
		<section name="Right Barrier">
			<attnum name="width" unit="m" val="0.0" />
			<attnum name="height" unit="m" val="4.0" />
			<attstr name="style" val="fence" />
			<attstr name="surface" val="manual-barrier" />
		</section>
		<section name="Pits">
			<attstr name="type" val="none" />
			<attstr name="side" val="right" />
			<attstr name="entry" val="" />
			<attstr name="start" val="" />
			<attstr name="end" val="" />
			<attstr name="exit" val="" />
			<attnum name="speed limit" unit="km/h" val="80" />
			<attnum name="length" unit="m" val="15" />
			<attnum name="width" unit="m" val="5.0" />
		</section>
		<section name="Track Segments">
			<section name="template-straight">
				<attstr name="type" val="str" />
				<attnum name="lg" unit="m" val="100.0" />
				<attnum name="z end" unit="m" val="0.0" />
			</section>
		</section>
	</section>
</params>
