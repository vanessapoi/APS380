<!DOCTYPE params SYSTEM "../../../src/libs/tgf/params.dtd" [
<!-- general definitions for tracks -->
<!ENTITY default-surfaces SYSTEM "../../../data/tracks/surfaces.xml">
]>

<params name="Over-Under 2" type="trackdef" mode="mw">

	<section name="Surfaces">
		&default-surfaces;
	</section>

	<section name="Header">
		<attstr name="name" val="Over-Under 2"/>
		<attstr name="category" val="road"/>
		<attnum name="version" val="4"/>
		<attstr name="author" val="Bernhard Wymann"/>
		<attstr name="description" val="Regression fixture with two grade-separated centerline crossings"/>
	</section>

	<section name="Graphic">
		<attstr name="3d description" val="over-under-2.ac"/>

		<section name="Terrain Generation">
			<attnum name="track step" unit="m" val="20"/>
			<attnum name="border margin" unit="m" val="70"/>
			<attnum name="border step" unit="m" val="40"/>
			<attnum name="terrain transition" unit="m" val="60"/>
			<attnum name="border height" unit="m" val="0"/>
			<attstr name="orientation" val="clockwise"/>
			<attstr name="surface" val="grass"/>
			<attstr name="crossing mode" val="auto"/>
			<attnum name="group size" val="200"/>
		</section>
	</section>

	<section name="Main Track">
		<attnum name="width" unit="m" val="10"/>
		<attstr name="surface" val="asphalt"/>
		<attnum name="profil steps length" unit="m" val="8"/>

		<section name="Track Segments">
			<section name="straight-1">
				<attstr name="type" val="str"/>
				<attnum name="lg" unit="m" val="244.448637286709"/>
				<attnum name="z start" unit="m" val="10.000000"/>
				<attnum name="profil start tangent" unit="%" val="0"/>
				<attnum name="z end" unit="m" val="10.000000"/>
				<attstr name="profil" in="linear,spline" val="spline"/>
				<attnum name="profil end tangent" unit="%" val="0"/>
			</section>

			<section name="turn-1">
				<attstr name="type" val="rgt"/>
				<attnum name="radius" unit="m" val="25.000000000000"/>
				<attnum name="arc" unit="deg" val="150.000000000000"/>
				<attnum name="z end" unit="m" val="5.000000"/>
				<attstr name="profil" in="linear,spline" val="spline"/>
				<attnum name="profil end tangent" unit="%" val="0"/>
			</section>

			<section name="straight-2">
